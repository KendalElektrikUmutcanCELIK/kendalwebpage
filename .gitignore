# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out-before/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify
graphify-out/
.graphify/

# ürün bilgi formu üretim çıktıları (her çalıştırmada yeniden üretilir)
urun_bilgi_formu_calisma_log.txt
urun_bilgi_formu_rapor.json

# eski ürün slug yönlendirme tablosu (her build'de scripts/generate-legacy-redirects.js ile yeniden üretilir)
public/legacy-redirects.json

# ürün özellik verisi, /urunler listeleme sayfalarının payload'unu küçük tutmak için
# products.json'dan ayrıldı (her build'de scripts/generate-product-attributes.js ile yeniden üretilir)
public/product-attributes.json

# dil bazlı haber verisi, ana sayfa/haberler sayfalarının payload'unu küçük tutmak için
# news.json'dan ayrıldı (her build'de scripts/generate-news-data.js ile yeniden üretilir)
public/news/

# admin panel gizli bilgileri (şifre hash'i + GitHub token) - asla commit edilmemeli,
# cPanel'e admin-panel/ yüklenirken git'ten BAĞIMSIZ olarak elle/FTP ile taşınır
admin-panel/config.php

# admin panelin otomatik yedekleri ve yüklenen dosyalar - çalışma zamanı verisi,
# her kayıtta yeni dosya üretir, git'te tutulursa sınırsız büyür
admin-panel/data/backups/
admin-panel/data/uploads/
