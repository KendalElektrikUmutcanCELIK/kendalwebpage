<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kendal Elektrik - IIS/Plesk (Windows) için .htaccess karşılığı.

  kendalelektrik.com, Natro üzerinde Windows Server 2019 + Plesk (IIS) ile
  barındırılıyor. IIS, Apache'nin .htaccess/mod_rewrite dosyasını OKUMAZ —
  aynı iş burada "IIS URL Rewrite" modülü ile web.config üzerinden yapılıyor.
  public/.htaccess dosyası (Apache/cPanel hedefleri için) hâlâ repoda duruyor,
  ikisi birbirini etkilemez; hangi sunucu hangi dosyayı anlıyorsa onu kullanır.
  Mantık public/.htaccess ile birebir aynı tutulmalı — biri değişirse diğeri
  de güncellenmeli.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!-- includeSubDomains/preload kasıtlı olarak eklenmedi, bkz. public/.htaccess'teki aynı not. -->
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; frame-src 'self' https://www.youtube.com; connect-src 'self'" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <!-- HTTPS zorunlu kıl (tüm host'lar için: ana domain + brand subdomain'leri) -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Ana domain için www zorunlu kıl (brand subdomain'lerini etkilemez) -->
        <rule name="Force WWW" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^kendalelektrik\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.kendalelektrik.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Eski ürün URL'lerinde "*" karakteri geçen linkler: statik export bu
             karakteri dosya adında barındıramadığı için build'de "-" ile
             değiştirildi (bkz. src/data/slug-map.json). Bu kural "*"lı eski
             adresi otomatik olarak "-"li güncel adrese yönlendirir. -->
        <rule name="Legacy asterisk redirect" stopProcessing="true">
          <match url="^([^*]*)\*([^*]*)$" />
          <action type="Redirect" url="{R:1}-{R:2}" redirectType="Permanent" />
        </rule>

        <!-- Marka subdomain yönlendirmesi: k2./vanti./global. -> ilgili
             /brand/{marka}/... statik içeriğine yönlendirir. ÖNKOŞUL: Plesk'te
             bu 3 subdomain, ana sitenin document root'u ile AYNI klasöre
             bakmalı (ayrı bir alt klasöre değil), aksi halde _next/images gibi
             paylaşılan dosyalar bulunamaz. -->
        <rule name="K2 subdomain" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^k2\.kendalelektrik\.com$" />
            <add input="{URL}" pattern="^/(_next|images|urun-bilgi-formlari|brand)(/|$)" negate="true" />
            <add input="{URL}" pattern="\.[a-zA-Z0-9]+$" negate="true" />
          </conditions>
          <action type="Rewrite" url="brand/k2/{R:1}" />
        </rule>

        <rule name="Vanti subdomain" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^vanti\.kendalelektrik\.com$" />
            <add input="{URL}" pattern="^/(_next|images|urun-bilgi-formlari|brand)(/|$)" negate="true" />
            <add input="{URL}" pattern="\.[a-zA-Z0-9]+$" negate="true" />
          </conditions>
          <action type="Rewrite" url="brand/vanti/{R:1}" />
        </rule>

        <rule name="Global subdomain" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^global\.kendalelektrik\.com$" />
            <add input="{URL}" pattern="^/(_next|images|urun-bilgi-formlari|brand)(/|$)" negate="true" />
            <add input="{URL}" pattern="\.[a-zA-Z0-9]+$" negate="true" />
          </conditions>
          <action type="Rewrite" url="brand/global/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
