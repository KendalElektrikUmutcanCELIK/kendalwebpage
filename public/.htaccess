# Kendal Elektrik - cPanel/Apache güvenlik ve yönlendirme ayarları
# Next.js static export (`output: "export"`) header/middleware konfigürasyonunu
# desteklemediği için bu ayarların hepsi burada, Apache seviyesinde tanımlanıyor.

RewriteEngine On

# --- HTTPS zorunlu kıl (tüm host'lar için: ana domain + brand subdomain'leri) ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Ana domain için www zorunlu kıl (brand subdomain'lerini etkilemez) ---
RewriteCond %{HTTP_HOST} ^kendalelektrik\.com$ [NC]
RewriteRule ^(.*)$ https://www.kendalelektrik.com/$1 [L,R=301]

# --- Eski ürün URL'lerinde "*" karakteri geçen linkler (ör. eski siteden gelen
# .../kasa*beyaz adresleri): statik export bu karakteri dosya adında
# barındıramadığı için build'de "-" ile değiştirildi (bkz. src/data/slug-map.json).
# Bu kural "*"lı eski adresi otomatik olarak "-"li güncel adrese yönlendirir, böylece
# eski link kırılmadan doğru ürün sayfasına ulaşır. ---
RewriteCond %{REQUEST_URI} ^/([^*]*)\*([^*]*)$
RewriteRule ^ /%1-%2 [R=301,L]

# --- Marka subdomain yönlendirmesi ---
# k2./vanti./global. -> ilgili /brand/{marka}/... statik içeriğine yönlendirir.
# Next.js'in kendi middleware'i (src/proxy.ts) statik export'ta ÇALIŞMADIĞI için
# bu iş burada yapılıyor. ÖNKOŞUL: cPanel'de bu 3 subdomain, ana sitenin
# document root'u ile AYNI klasöre bakmalı (ayrı bir alt klasöre değil),
# aksi halde _next/images gibi paylaşılan dosyalar bulunamaz.
RewriteCond %{HTTP_HOST} ^k2\.kendalelektrik\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(_next|images|urun-bilgi-formlari|brand)(/|$)
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^(.*)$ /brand/k2/$1 [L]

RewriteCond %{HTTP_HOST} ^vanti\.kendalelektrik\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(_next|images|urun-bilgi-formlari|brand)(/|$)
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^(.*)$ /brand/vanti/$1 [L]

RewriteCond %{HTTP_HOST} ^global\.kendalelektrik\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/(_next|images|urun-bilgi-formlari|brand)(/|$)
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteRule ^(.*)$ /brand/global/$1 [L]

# --- Özel 404 sayfası (Next'in ürettiği statik 404.html) ---
ErrorDocument 404 /404.html

# --- Güvenlik başlıkları ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # NOT: includeSubDomains/preload kasıtlı olarak eklenmedi. Bu domain
  # altındaki diğer alt alan adlarının (mail, webmail, b2b, sanalpos vb.)
  # https üzerinde sorunsuz çalıştığı teyit edilmeden bu iki seçenek
  # eklenmemeli - eklenirse ve bir alt alan adı https'i desteklemezse,
  # tarayıcılar o adrese aylarca erişemez hale gelir.
  Header always set Strict-Transport-Security "max-age=31536000"

  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; frame-src 'self' https://www.youtube.com; connect-src 'self'"
</IfModule>

# --- Dizin listelemeyi kapat ---
Options -Indexes
